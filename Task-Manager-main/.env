# Define the name of the database for the task manager application
DB_NAME=task_manager  # This is the database name for the task manager

# Specify the database host (where the database server is running)
DB_HOST=localhost  # The database is hosted locally on your machine

# Provide the username to authenticate with the database
DB_USER=root  # The database username (root is typically used for local development)

# Provide the password associated with the database username
DB_PASSWORD=Floodescape2  # The password for the root user (trust me nobody is getting though this)

# Re-define the database name (it seems to overwrite the previous DB_NAME value)
DB_NAME=fintech  # This overwrites the earlier DB_NAME (so now it will refer to the 'fintech' database)

# Define the port number the database will use (default for MySQL is 3306)
PORT=3306  # Port for the MySQL database (the default port for MySQL is 3306)
